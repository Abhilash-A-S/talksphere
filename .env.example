# Copy to .env and use strong, unique passwords; never commit .env
POSTGRES_PASSWORD=replace-with-a-strong-random-password
REDIS_PASSWORD=replace-with-a-strong-random-password
DATABASE_URL=postgresql://talksphere:replace-with-a-strong-random-password@localhost:5432/talksphere
REDIS_URL=redis://:replace-with-a-strong-random-password@localhost:6379
PORT=3000
